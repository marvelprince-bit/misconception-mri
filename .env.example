# Copy to .env (never commit .env) or export these in your terminal.
# Only needed for the live AI rule-writer. Everything else runs with no key.
GEMINI_API_KEY=
# Optional. Check the provider's model list for current IDs.
MRI_MODEL=gemini-3.8-flash
# Alternative live AI rule-writer (use either key; pick with --writer claude or --writer gemini).
ANTHROPIC_API_KEY=
MRI_CLAUDE_MODEL=claude-sonnet-5-5
MRI_CLAUDE_MAX_TOKENS=8000
